{
  "name": "character-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "dev": "pnpm demo:assets && pnpm --filter @character-studio/app dev",
    "demo:assets": "pnpm --filter @character-studio/render-demo build && node tools/render-demo/dist/generate-assets.js",
    "demo:export": "pnpm demo:assets && node tools/render-demo/dist/export-demo.js",
    "reference:import": "pnpm --filter @character-studio/asset-validator build && node tools/asset-validator/dist/import-cli.js",
    "hair:review": "pnpm --filter @character-studio/asset-validator build && node tools/asset-validator/dist/hair-review-cli.js",
    "hair:review:profiles": "pnpm --filter @character-studio/asset-validator build && node tools/asset-validator/dist/hair-review-cli.js --profiles",
    "hair:review:front-diagonals": "pnpm --filter @character-studio/asset-validator build && node tools/asset-validator/dist/hair-review-cli.js --front-diagonals",
    "hair:review:front-diagonals:completion": "pnpm --filter @character-studio/asset-validator build && node tools/asset-validator/dist/hair-review-cli.js --front-diagonals-completion",
    "build": "pnpm demo:assets && pnpm -r build",
    "typecheck": "tsc --noEmit && pnpm -r typecheck",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium --only-shell",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "verify:all": "pnpm verify && pnpm test:e2e",
    "hair:review:back-diagonals": "pnpm --filter @character-studio/asset-validator build && node tools/asset-validator/dist/hair-review-cli.js --back-diagonals",
    "head:review": "pnpm --filter @character-studio/asset-validator build && node tools/asset-validator/dist/head-review-cli.js",
    "head:review:v1": "pnpm --filter @character-studio/asset-validator build && node tools/asset-validator/dist/head-review-cli.js --v1",
    "head:review:v2": "pnpm --filter @character-studio/asset-validator build && node tools/asset-validator/dist/head-review-cli.js --v2",
    "head:review:v3": "pnpm --filter @character-studio/asset-validator build && node tools/asset-validator/dist/head-review-cli.js --v3",
    "head:review:v4": "pnpm --filter @character-studio/asset-validator build && node tools/asset-validator/dist/head-review-cli.js --v4",
    "head:review:profiles": "pnpm --filter @character-studio/asset-validator build && node tools/asset-validator/dist/head-review-cli.js --profiles",
    "head:review:profiles:v1": "pnpm --filter @character-studio/asset-validator build && node tools/asset-validator/dist/head-review-cli.js --profiles-v1",
    "head:review:profiles:v2": "pnpm --filter @character-studio/asset-validator build && node tools/asset-validator/dist/head-review-cli.js --profiles-v2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@playwright/test": "1.64.0",
    "@types/node": "^24.0.0",
    "eslint": "^10.0.0",
    "globals": "^17.0.0",
    "tsup": "^8.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^4.0.0"
  }
}
